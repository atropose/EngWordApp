<!doctype html><html><head><meta charset="utf-8"><title><%= weekId %></title><link rel="stylesheet" href="/main.css"></head><body><div class="container">
<h1><%= weekId %></h1>
<form method="post" action="/weeks/<%= weekId %>/upload" enctype="multipart/form-data">
  <input type="file" name="photos" multiple required>
  <button class="btn" type="submit">Upload Photos</button>
</form>
<p>Uploads: <%= uploads.length %></p>
<div class="actions">
<form method="post" action="/weeks/<%= weekId %>/extract"><button class="btn">Run Extraction</button></form>
<a class="btn" href="/weeks/<%= weekId %>/validate">Validate / Edit</a>
<form method="post" action="/weeks/<%= weekId %>/generate"><button class="btn">Generate Images</button></form>
<form method="post" action="/weeks/<%= weekId %>/buildZip"><button class="btn">Build ZIP</button></form>
<a class="btn" href="/weeks/<%= weekId %>/download">Download ZIP</a>
<form method="post" action="/weeks/<%= weekId %>/regenerate"><button class="btn">Regenerate Images</button></form>
</div>
<div id="status"></div>
<script>
(async function poll(){
 const r=await fetch('/api/weeks/<%= weekId %>/status'); const s=await r.json();
 document.getElementById('status').textContent=`${s.job||'idle'} ${s.state||''} ${s.current||0}/${s.total||0} ${s.message||''}`;
 setTimeout(poll,2000);
})();
</script>
<a href="/weeks">Back</a>
</div></body></html>
